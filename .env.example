# =============================================================================
# remem — Environment Configuration Template
# Copy this file to .env and configure your secret credentials and preferences.
# =============================================================================

# --- Project Selection ---
REMEM_PROJECT=default

# --- LLM Provider API Keys ---
# At least one provider API key is required for reasoning operations in production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Provider Selection ---
# Supported options: "anthropic" (default), "openai", "google", "local", "mock"
REMEM_PROVIDER=anthropic
REMEM_REASONING_MODEL=
REMEM_SCORING_MODEL=
REMEM_LOCAL_MODEL_PATH=models/nomic-embed-text.onnx

# --- REST API & MCP Authentication ---
# Bearer token for API authentication. If unset, the server runs in open (dev) mode.
REMEM_API_KEY=
REMEM_CURSOR_SECRET=

# --- CORS Configuration ---
# Configurable allowed origins, e.g. "http://localhost:3000,http://127.0.0.1:3000" or "*"
REMEM_CORS_ORIGIN=

# --- Rate Limiting & Proxy Security ---
# Set to 1 or true only if deployed behind a trusted reverse proxy (e.g. Nginx, Cloudflare, AWS ALB)
REMEM_TRUST_PROXY_HEADERS=0

# --- Storage Configuration ---
# Root data directory (defaults to ~/.remem)
REMEM_DATA_DIR=

# --- Observability & Logging ---
# RUST_LOG filter directives: trace, debug, info, warn, error
RUST_LOG=rememhq=info,tower_http=debug
